{
    "name": "enzoaccardo/ci4-adminkit",
    "description": "Admin kit per CodeIgniter 4: Smarty + list builder (filtri/ordinamento/paginazione) + form builder (widget, interazioni, AJAX)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vincenzo Accardo",
            "email": "vincenzo.accardo@w3style.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "smarty/smarty": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "AdminKit\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
